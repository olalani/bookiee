WHATSAPP_VERIFY_TOKEN="bookiee-webhook-verify"
WHATSAPP_APP_SECRET=""

# Paystack
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Python NLP Service
NLP_SERVICE_URL="http://localhost:8001"

# S3 / Object Storage (for audio files)
S3_BUCKET="bookiee-audio"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
